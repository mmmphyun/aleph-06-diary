rules_version = '2';

/**
 * Cloud Firestore Security Rules
 * Project: pds-diary-t06 (플랜두씨 다이어리 2 / 과제 7 - Milestone M2)
 *
 * Operational Mode:
 * - User-isolated authenticated access with strict ownership enforcement (T07-C100, T07-C124, T07-C125).
 * - All collection operations require authentication (request.auth != null).
 * - Read / Update / Delete: resource.data.userId == request.auth.uid.
 * - Create: request.resource.data.userId == request.auth.uid.
 * - Enforces schema integrity, string/array limits (DoS prevention), and key immutability.
 * - All undefined collections are denied by default.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper & Validation Functions
    // ---------------------------------------------------------------

    function isValidPriority(priority) {
      return priority in ['high', 'medium', 'low'];
    }

    function isValidTaskStatus(status) {
      return status in ['todo', 'in_progress', 'done'];
    }

    function isValidTrashStatus(ts) {
      return ts in [0, 1, 2];
    }

    function isValidPeriod(data) {
      return !('period' in data) ||
        data.period == null ||
        (
          data.period is map &&
          (!('start' in data.period) || (data.period.start is string && data.period.start.size() <= 50)) &&
          (!('end' in data.period) || (data.period.end is string && data.period.end.size() <= 50))
        );
    }

    function isValidRevisions(data) {
      return !('revisions' in data) || (
        data.revisions is list &&
        data.revisions.size() <= 500
      );
    }

    function isValidTags(data) {
      return !('tags' in data) || (
        data.tags is list &&
        data.tags.size() <= 50
      );
    }

    function isValidUserId(userId) {
      return userId is string && userId.size() > 0 && userId.size() <= 128;
    }

    // Domain validator for plans
    function isValidPlan(data, planId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'startPage', 'createdAt', 'trashStatus']) &&
        data.keys().hasOnly([
          'id', 'userId', 'title', 'content', 'revisions', 'startPage',
          'tasksTemplateApplied', 'planStatus', 'period', 'createdAt',
          'updatedAt', 'trashStatus', 'trashedAt', 'retentionDays',
          'priority', 'successCriteria', 'estimatedMinutes', 'revisionCount',
          'periodStart', 'periodEnd'
        ]) &&
        isValidUserId(data.userId) &&
        data.id is string && data.id == planId && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 50000 &&
        data.startPage is int && data.startPage >= 1 && data.startPage <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        isValidTrashStatus(data.trashStatus) &&
        isValidRevisions(data) &&
        isValidPeriod(data) &&
        (!('tasksTemplateApplied' in data) || data.tasksTemplateApplied is bool) &&
        (!('planStatus' in data) || data.planStatus in ['draft', 'confirmed']) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
        (!('trashedAt' in data) || data.trashedAt == null || (data.trashedAt is string && data.trashedAt.size() <= 50)) &&
        (!('retentionDays' in data) || (data.retentionDays is int && data.retentionDays >= 0 && data.retentionDays <= 365));
    }

    // Domain validator for tasks
    function isValidTask(data, taskId) {
      return data.keys().hasAll(['id', 'userId', 'planId', 'title', 'done', 'startDate', 'dueDate', 'priority', 'tags', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'planId', 'title', 'done', 'startDate',
          'dueDate', 'priority', 'description', 'tags', 'estimatedMinutes',
          'status', 'completedAt', 'createdAt', 'updatedAt', 'trashStatus',
          'trashedAt', 'retentionDays'
        ]) &&
        isValidUserId(data.userId) &&
        data.id is string && data.id == taskId && data.id.size() <= 128 &&
        data.planId is string && data.planId.size() > 0 && data.planId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.done is bool &&
        data.startDate is string && data.startDate.size() <= 50 &&
        data.dueDate is string && data.dueDate.size() <= 50 &&
        isValidPriority(data.priority) &&
        isValidTags(data) &&
        isValidTaskStatus(data.status) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('estimatedMinutes' in data) || (data.estimatedMinutes is int && data.estimatedMinutes >= 0 && data.estimatedMinutes <= 100000)) &&
        (!('completedAt' in data) || data.completedAt == null || (data.completedAt is string && data.completedAt.size() <= 50)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
        (!('trashStatus' in data) || isValidTrashStatus(data.trashStatus)) &&
        (!('trashedAt' in data) || data.trashedAt == null || (data.trashedAt is string && data.trashedAt.size() <= 50)) &&
        (!('retentionDays' in data) || (data.retentionDays is int && data.retentionDays >= 0 && data.retentionDays <= 365));
    }

    // Domain validator for executionLogs / logs
    function isValidExecutionLog(data, logId) {
      return data.keys().hasAll(['id', 'userId', 'planId', 'taskId', 'taskTitle', 'completedAt', 'comment']) &&
        data.keys().hasOnly([
          'id', 'userId', 'planId', 'taskId', 'taskTitle', 'completedAt',
          'startedAt', 'endedAt', 'actualMinutes', 'impediment', 'blockerReason',
          'comment', 'createdAt', 'trashStatus', 'trashedAt', 'retentionDays'
        ]) &&
        isValidUserId(data.userId) &&
        data.id is string && data.id == logId && data.id.size() <= 128 &&
        data.planId is string && data.planId.size() > 0 && data.planId.size() <= 128 &&
        data.taskId is string && data.taskId.size() > 0 && data.taskId.size() <= 128 &&
        data.taskTitle is string && data.taskTitle.size() <= 200 &&
        data.completedAt is string && data.completedAt.size() <= 50 &&
        data.comment is string && data.comment.size() <= 5000 &&
        (!('startedAt' in data) || data.startedAt == null || (data.startedAt is string && data.startedAt.size() <= 50)) &&
        (!('endedAt' in data) || data.endedAt == null || (data.endedAt is string && data.endedAt.size() <= 50)) &&
        (!('actualMinutes' in data) || (data.actualMinutes is int && data.actualMinutes >= 0 && data.actualMinutes <= 100000)) &&
        (!('impediment' in data) || (data.impediment is string && data.impediment.size() <= 5000)) &&
        (!('blockerReason' in data) || (data.blockerReason is string && data.blockerReason.size() <= 5000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('trashStatus' in data) || isValidTrashStatus(data.trashStatus)) &&
        (!('trashedAt' in data) || data.trashedAt == null || (data.trashedAt is string && data.trashedAt.size() <= 50)) &&
        (!('retentionDays' in data) || (data.retentionDays is int && data.retentionDays >= 0 && data.retentionDays <= 365));
    }

    // Domain validator for planHistories / planRevisions
    function isValidPlanHistory(data, historyId) {
      return data.keys().hasAll(['userId', 'planId']) &&
        isValidUserId(data.userId) &&
        data.planId is string && data.planId.size() > 0 && data.planId.size() <= 128 &&
        (!('id' in data) || (data.id is string && data.id == historyId && data.id.size() <= 128)) &&
        (!('revisionNumber' in data) || (data.revisionNumber is int && data.revisionNumber >= 0)) &&
        (!('trashStatus' in data) || isValidTrashStatus(data.trashStatus)) &&
        (!('trashedAt' in data) || data.trashedAt == null || (data.trashedAt is string && data.trashedAt.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('revisedAt' in data) || (data.revisedAt is string && data.revisedAt.size() <= 50));
    }

    // ---------------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------------

    // 1. plans 컬렉션
    match /plans/{planId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        isValidPlan(request.resource.data, planId);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidPlan(request.resource.data, planId) &&
        request.resource.data.id == resource.data.id &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
    }

    // 2. tasks 컬렉션
    match /tasks/{taskId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        isValidTask(request.resource.data, taskId);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidTask(request.resource.data, taskId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
    }

    // 3. executionLogs 컬렉션 (및 logs 별칭 지원)
    match /executionLogs/{logId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        isValidExecutionLog(request.resource.data, logId);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidExecutionLog(request.resource.data, logId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.taskId == resource.data.taskId;
    }

    match /logs/{logId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        isValidExecutionLog(request.resource.data, logId);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidExecutionLog(request.resource.data, logId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.taskId == resource.data.taskId;
    }

    // 4. planHistories 컬렉션 (및 planRevisions 별칭 지원)
    match /planHistories/{historyId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        isValidPlanHistory(request.resource.data, historyId);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidPlanHistory(request.resource.data, historyId) &&
        (!('planId' in resource.data) || request.resource.data.planId == resource.data.planId);
    }

    match /planRevisions/{revisionId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        isValidPlanHistory(request.resource.data, revisionId);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isValidPlanHistory(request.resource.data, revisionId) &&
        (!('planId' in resource.data) || request.resource.data.planId == resource.data.planId);
    }

    // ---------------------------------------------------------------
    // Default Deny Rule: Block all access to undefined collections
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
